---
export interface TimelineItem {
  href: string;
  title: string;
  venue?: string | null;
  dateLabel: string;
  status: string;
}

export interface Props {
  timeline: TimelineItem[];
  id?: string;
  hidden?: boolean;
}

const { timeline, id = 'timeline-row', hidden = false } = Astro.props;

const statusDot: Record<string, string> = {
  Published: 'bg-success',
  Accepted: 'bg-warning',
  'Under Review': 'bg-gray-400',
};
---

{
  timeline.length > 0 && (
    <div id={id} class:list={['flex items-start gap-0 overflow-x-auto pb-2', hidden && 'hidden']}>
      {timeline.map((p, i) => (
        <>
          {i > 0 && <div class="mt-1.5 h-px w-6 shrink-0 bg-[var(--border)] sm:w-10" />}
          <a href={p.href} class="group flex w-48 shrink-0 flex-col gap-1.5 px-2 first:pl-0">
            <span class:list={['block h-3 w-3 rounded-full', statusDot[p.status] ?? 'bg-gray-400']} />
            <p class="p-tiny text-[var(--text-secondary)]">
              {p.dateLabel} &middot; {p.status}
            </p>
            <h4 class="line-clamp-2 text-sm font-semibold text-[var(--text-primary)] group-hover:text-primary">{p.title}</h4>
            <p class="p-tiny line-clamp-1 italic text-[var(--text-secondary)]">{p.venue}</p>
          </a>
        </>
      ))}
    </div>
  )
}
