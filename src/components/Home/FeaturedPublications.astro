---
import { getEntry } from 'astro:content';
import PublicationCard from '../Cards/PublicationCard.astro';

const publishedEntry = await getEntry('publicationsPublished', 'data');
const acceptedEntry = await getEntry('publicationsAccepted', 'data');

const all = [
  ...publishedEntry.data.published.map((p) => ({
    href: `/publications/${p.id}`,
    title: p.title,
    authors: p.authors,
    venue: p.conference,
    year: p.year,
    status: p.status,
    keywords: p.keywords,
    featured: p.featured,
  })),
  ...acceptedEntry.data.accepted.map((p) => ({
    href: `/publications/${p.id}`,
    title: p.title,
    authors: p.authors,
    venue: p.conference,
    year: p.year,
    status: p.status,
    keywords: p.keywords,
    featured: p.featured,
  })),
];

const featured = all.filter((p) => p.featured).sort((a, b) => b.year - a.year);
const rest = all.filter((p) => !p.featured).sort((a, b) => b.year - a.year);
const topPublications = [...featured, ...rest].slice(0, 3);
---

<section class="bg-[var(--bg-secondary)] px-4 py-2xl md:px-6 lg:px-12">
  <div class="mx-auto flex max-w-container flex-col gap-6">
    <div class="flex items-center justify-between gap-4">
      <h2>Featured Publications</h2>
      <a href="/publications" class="link text-sm" data-i18n="common.viewAllPublications">View all publications</a>
    </div>

    {
      topPublications.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {topPublications.map((p) => (
            <PublicationCard {...p} />
          ))}
        </div>
      ) : (
        <p class="p-small text-[var(--text-secondary)]">No publications on file yet.</p>
      )
    }
  </div>
</section>
