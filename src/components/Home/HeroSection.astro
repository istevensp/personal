---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import profileImage from '../../assets/images/profile.jpg';

const personalEntry = await getEntry('personal', 'data');
const interestsEntry = await getEntry('interests', 'data');
const academicEntry = await getEntry('academicExperience', 'data');

const personal = personalEntry.data;
const featuredCategories = ['IoT and Cyber-Physical Systems', 'Cloud and Distributed Computing', 'AI and Data-Driven Systems'];
const topInterests = featuredCategories
  .map((name) => interestsEntry.data.researchInterests.find((group) => group.category === name))
  .filter((group): group is NonNullable<typeof group> => Boolean(group))
  .map((group) => ({ en: group.category, es: group.categoryEs }));
const currentRole = academicEntry.data.academicExperience.find((exp) => exp.current);

const [emailUser, emailDomain] = personal.email.institutional.split('@');
const initials = `${personal.firstName[0]}${personal.lastName[0]}`.toUpperCase();
const heroName = `${personal.firstName} ${personal.lastName}`;
---

<section class="animate-fade-in bg-gradient-to-br from-primary/10 via-transparent to-secondary/10 px-4 py-3xl md:px-6 lg:px-12">
  <div class="mx-auto grid max-w-container grid-cols-1 items-start gap-8 md:grid-cols-[1fr_auto]">
    <div class="flex flex-col gap-4">
      <h1 class="max-w-2xl">{heroName}</h1>

      {
        currentRole && (
          <p class="text-lg font-medium text-[var(--text-primary)]">
            <span
              data-lang-en={currentRole.titleEs ? currentRole.title : undefined}
              data-lang-es={currentRole.titleEs}
            >
              {currentRole.title}
            </span>
            <br />
            {currentRole.institution}
          </p>
        )
      }

      <a href="/about" class="group block max-w-2xl">
        <p
          class="text-[var(--text-secondary)] transition-colors group-hover:text-primary"
          data-lang-en={personal.taglineEs ? personal.tagline : undefined}
          data-lang-es={personal.taglineEs}
        >
          {personal.tagline}
        </p>
      </a>

      <div class="flex flex-wrap gap-2">
        {topInterests.map((interest) => (
          <span class="badge" data-lang-en={interest.es ? interest.en : undefined} data-lang-es={interest.es}>
            {interest.en}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-1 text-sm">
        <a href={`mailto:${personal.email.institutional}`} class="link flex min-h-[44px] items-center gap-1.5 text-[var(--text-secondary)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          {emailUser}(at){emailDomain}
        </a>

        <a
          href={personal.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="link flex min-h-[44px] items-center gap-1.5 text-[var(--text-secondary)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.94c.57.1.78-.25.78-.55v-2c-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.07.78 2.16v3.2c0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
          </svg>
          GitHub
        </a>

        <a
          href={personal.socials.googleScholar}
          target="_blank"
          rel="noopener noreferrer"
          class="link flex min-h-[44px] items-center gap-1.5 text-[var(--text-secondary)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2 1 9l4 2.5V17l7 4 7-4v-5.5L23 9 12 2zm0 2.4L19.5 9 12 13.6 4.5 9 12 4.4zM6.5 12.7 12 16l5.5-3.3V16L12 19.3 6.5 16v-3.3z" />
          </svg>
          Google Scholar
        </a>

        <a
          href={personal.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="link flex min-h-[44px] items-center gap-1.5 text-[var(--text-secondary)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0z" />
          </svg>
          LinkedIn
        </a>

        <a
          href={personal.socials.researchGate}
          target="_blank"
          rel="noopener noreferrer"
          class="link flex min-h-[44px] items-center gap-1.5 text-[var(--text-secondary)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.6 21.4c-.6 0-1.2-.2-1.7-.5-.8-.5-1.5-1.4-2.4-2.7l-2.1-3.2c-.2 0-.4 0-.6 0h-1v3.6c0 .8.2.9 1.1 1v.7H6.6v-.7c.9-.1 1.1-.2 1.1-1V7.5c0-.8-.2-.9-1.1-1v-.7h5.6c2.9 0 4.6 1.3 4.6 3.6 0 1.7-1 2.9-2.7 3.4l1.7 2.6c1.1 1.7 1.7 2.4 2.3 2.8.3.2.6.3 1 .3l.1.7c-.4.1-.9.2-1.6.2zm-6.9-7.5c1.7 0 2.6-.9 2.6-2.5s-.9-2.4-2.7-2.4h-1.3v4.9h1.4z" />
          </svg>
          ResearchGate
        </a>

        <a
          href={`https://orcid.org/${personal.socials.orcid}`}
          target="_blank"
          rel="noopener noreferrer"
          class="link flex min-h-[44px] items-center gap-1.5 text-[var(--text-secondary)]"
          title="ORCID identifier"
        >
          <img src="/images/ORCID_iD.svg" width="16" height="16" alt="" aria-hidden="true" />
          ORCID: {personal.socials.orcid}
        </a>
      </div>

      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/projects" class="btn-primary">View Projects</a>
        <a href="/contact" class="btn-secondary">Get in Touch</a>
      </div>
    </div>

    <div class="relative mx-auto h-56 w-56 shrink-0 overflow-hidden rounded-2xl border border-[var(--border)] bg-gradient-to-br from-primary to-secondary shadow-lg md:mx-0 md:h-64 md:w-64">
      <span class="absolute inset-0 flex items-center justify-center text-6xl font-semibold text-white">
        {initials}
      </span>
      <Image
        src={profileImage}
        alt={personal.fullName}
        width={256}
        height={256}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
  </div>
</section>
