---
import { getEntry } from 'astro:content';

const awardsEntry = await getEntry('awardsHonors', 'data');
const awards = awardsEntry.data.awards;
---

<section class="px-4 py-2xl md:px-6 lg:px-12">
  <div class="mx-auto flex max-w-container flex-col gap-6">
    <h2>Awards &amp; Honors</h2>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        awards.map((award) => (
          <div class="card flex flex-col gap-2">
            <span class="badge w-fit">{award.type}</span>
            <h4 class="text-xl font-semibold text-[var(--text-primary)]">{award.name}</h4>
            <p class="p-small text-[var(--text-secondary)]">{award.issuer}</p>
            {award.year && <p class="p-tiny text-[var(--text-secondary)]">{award.year}</p>}
            <p class="p-small text-[var(--text-secondary)]">{award.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
