---
import { getCollection } from 'astro:content';
import ProjectCard from '../Cards/ProjectCard.astro';

const research = await getCollection('projectsResearch', ({ data }) => !data.draft && data.current);

const topProjects = research
  .map((p) => ({
    href: `/projects/research/${p.data.projectId}`,
    name: p.data.name,
    year: p.data.year,
    myRole: p.data.myRole,
    excerpt: p.data.problem,
    type: 'research' as const,
    current: p.data.current,
    featured: p.data.featured,
  }))
  .sort((a, b) => b.year - a.year);
---

<section class="px-4 py-2xl md:px-6 lg:px-12">
  <div class="mx-auto flex max-w-container flex-col gap-6">
    <div class="flex items-center justify-between gap-4">
      <h2>
        <a href="/projects" class="transition-colors hover:text-primary" data-i18n="home.currentResearchProjects">
          Current Research Projects
        </a>
      </h2>
      <a href="/projects" class="btn-ghost group min-h-[44px] text-sm">
        <span data-i18n="common.viewAllProjects">View all projects</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="transition-transform duration-fast group-hover:translate-x-0.5"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>

    {
      topProjects.length > 0 ? (
        <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 [mask-image:linear-gradient(to_right,black_calc(100%-3rem),transparent)] [-webkit-mask-image:linear-gradient(to_right,black_calc(100%-3rem),transparent)]">
          {topProjects.map((p) => (
            <div class="w-[300px] shrink-0 snap-start sm:w-[360px]">
              <ProjectCard {...p} />
            </div>
          ))}
        </div>
      ) : (
        <p class="p-small text-[var(--text-secondary)]" data-i18n="home.noProjectsYet">No projects published yet.</p>
      )
    }
  </div>
</section>
