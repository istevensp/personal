---
import { getCollection } from 'astro:content';
import ProjectCard from '../Cards/ProjectCard.astro';

const research = await getCollection('projectsResearch', ({ data }) => !data.draft);
const community = await getCollection('projectsCommunity', ({ data }) => !data.draft);

const all = [
  ...research.map((p) => ({
    href: `/projects/research/${p.data.projectId}`,
    name: p.data.name,
    year: p.data.year,
    myRole: p.data.myRole,
    excerpt: p.data.problem,
    type: 'research' as const,
    current: p.data.current,
    featured: p.data.featured,
  })),
  ...community.map((p) => ({
    href: `/projects/community/${p.data.projectId}`,
    name: p.data.name,
    year: p.data.year,
    myRole: p.data.myRole,
    excerpt: p.data.description,
    type: 'community' as const,
    current: p.data.current,
    featured: p.data.featured,
  })),
];

const featured = all.filter((p) => p.featured).sort((a, b) => b.year - a.year);
const rest = all.filter((p) => !p.featured).sort((a, b) => b.year - a.year);
const topProjects = [...featured, ...rest].slice(0, 3);
---

<section class="px-4 py-2xl md:px-6 lg:px-12">
  <div class="mx-auto flex max-w-container flex-col gap-6">
    <div class="flex items-center justify-between gap-4">
      <h2>Featured Projects</h2>
      <a href="/projects" class="link text-sm" data-i18n="common.viewAllProjects">View all projects</a>
    </div>

    {
      topProjects.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {topProjects.map((p) => (
            <ProjectCard {...p} />
          ))}
        </div>
      ) : (
        <p class="p-small text-[var(--text-secondary)]">No projects published yet.</p>
      )
    }
  </div>
</section>
