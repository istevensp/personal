---
export interface Semester {
  semester: string;
  parallel: string;
  evaluationUrl: string | null;
  status?: 'completed' | 'in-progress' | 'upcoming';
}

export interface Props {
  id?: string;
  name: string;
  nameEs?: string;
  nameHref?: string;
  code: string;
  level: string;
  description: string;
  descriptionEs?: string;
  topics: string[];
  repositoryUrl: string;
  materialsLink?: string;
  semesters: Semester[];
  syllabusHref?: string;
}

const { id, name, nameEs, nameHref, code, level, description, descriptionEs, topics, repositoryUrl, materialsLink, semesters, syllabusHref } = Astro.props;
const hasCode = code && code !== '[PROPORCIONAR]';
const hasLevel = level && level !== '[PROPORCIONAR]';
const hasRepo = repositoryUrl && repositoryUrl !== '[PROPORCIONAR]';
const hasMaterialsLink = materialsLink && materialsLink !== '[PROPORCIONAR]';

const hasInProgress = semesters.some((s) => s.status === 'in-progress');
const hasUpcoming = semesters.some((s) => s.status === 'upcoming');

const years = Array.from(
  new Set(
    semesters
      .map((s) => parseInt(s.semester.split('-')[0], 10))
      .filter((y) => !Number.isNaN(y))
  )
).sort((a, b) => b - a);

// One consistent color per year (same year = same color on every card,
// since it's a pure function of the year number) — only the years get
// colored; the course code badge stays the plain default `.badge` color.
// Deliberately no red/rose/pink/orange/amber tones here — those read as
// warning/error/alarm (they're already used for the "In Progress"/
// "Upcoming"/error badges elsewhere), which looked alarmist for something
// as neutral as a year.
const YEAR_COLORS = [
  'bg-emerald-100 text-emerald-800',
  'bg-teal-100 text-teal-800',
  'bg-cyan-100 text-cyan-800',
  'bg-sky-100 text-sky-800',
  'bg-blue-100 text-blue-800',
  'bg-indigo-100 text-indigo-800',
  'bg-violet-100 text-violet-800',
  'bg-purple-100 text-purple-800',
  'bg-fuchsia-100 text-fuchsia-800',
  'bg-lime-100 text-lime-800',
];
function yearColor(year: number): string {
  return YEAR_COLORS[((year % YEAR_COLORS.length) + YEAR_COLORS.length) % YEAR_COLORS.length];
}

---

<div id={id} class="card flex scroll-mt-24 flex-col gap-3">
  <div class="flex flex-wrap items-center gap-2">
    {hasCode && <span class="badge">{code}</span>}
    {years.map((y) => (
      <span class:list={['rounded-full px-2 py-1 text-xs font-medium', yearColor(y)]}>{y}</span>
    ))}
    {hasLevel && <span class="p-tiny text-[var(--text-secondary)]">{level}</span>}
    {hasInProgress && <span class="badge badge-warning">In Progress</span>}
    {!hasInProgress && hasUpcoming && <span class="badge badge-success">Upcoming</span>}
  </div>

  <h4 class="text-xl font-semibold text-[var(--text-primary)]">
    {nameHref ? (
      <a href={nameHref} class="transition-colors hover:text-primary" data-lang-en={nameEs ? name : undefined} data-lang-es={nameEs}>
        {name}
      </a>
    ) : (
      <span data-lang-en={nameEs ? name : undefined} data-lang-es={nameEs}>{name}</span>
    )}
  </h4>
  <p class="p-small text-[var(--text-secondary)]" data-lang-en={descriptionEs ? description : undefined} data-lang-es={descriptionEs}>{description}</p>

  {
    topics.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {topics.map((t) => (
          <span class="badge">{t}</span>
        ))}
      </div>
    )
  }

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    {
      syllabusHref && (
        <a href={syllabusHref} class="link inline-flex min-h-[44px] w-fit items-center text-sm">
          <span data-i18n="teaching.viewCourseDetails">View course details</span>
        </a>
      )
    }
    {
      hasMaterialsLink && (
        <a href={materialsLink} class="link inline-flex min-h-[44px] w-fit items-center text-sm">
          Course materials
        </a>
      )
    }
    {
      hasRepo && (
        <a href={repositoryUrl} target="_blank" rel="noopener noreferrer" class="link inline-flex min-h-[44px] w-fit items-center text-sm">
          Course repository
        </a>
      )
    }
  </div>

  {
    semesters.length > 0 ? (
      <details class="group mt-1 rounded-md border border-[var(--border)]">
        <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-sm font-medium text-[var(--text-primary)]">
          <span data-i18n="common.viewEvaluations">View evaluations</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="shrink-0 transition-transform duration-fast group-open:rotate-180"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <ul class="flex flex-col gap-1 border-t border-[var(--border)] p-3">
          {semesters.map((s) =>
            s.evaluationUrl ? (
              <li>
                <a
                  href={s.evaluationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link flex min-h-[44px] items-center justify-between gap-2 text-sm"
                >
                  <span>
                    {s.semester} &middot; Parallel {s.parallel}
                  </span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ) : (
              <li class="flex min-h-[44px] items-center justify-between gap-2 text-sm text-[var(--text-secondary)]">
                <span>
                  {s.semester} &middot; Parallel {s.parallel}
                </span>
                <span class:list={['badge', s.status === 'upcoming' ? 'badge-success' : 'badge-warning']}>
                  {s.status === 'upcoming' ? 'Upcoming' : 'Pending evaluation'}
                </span>
              </li>
            )
          )}
        </ul>
      </details>
    ) : (
      <p class="p-tiny text-[var(--text-secondary)]">No semester evaluations on file yet.</p>
    )
  }
</div>
