---
export interface Props {
  href: string;
  title: string;
  authors: string[];
  venue: string;
  dateLabel: string;
  status: string;
  keywords: string[];
  externalLink?: { url: string; label: string } | null;
}

const { href, title, authors, venue, dateLabel, status, keywords, externalLink = null } = Astro.props;

const statusBadgeClass =
  status === 'Published' ? 'badge-success' : status === 'Accepted' ? 'badge-warning' : '';
const statusI18nKey =
  status === 'Published'
    ? 'publications.published'
    : status === 'Accepted'
      ? 'publications.accepted'
      : status === 'Under Review'
        ? 'publications.underReview'
        : undefined;
---

<div class="card animate-fade-in flex flex-col gap-3">
  <div class="flex flex-wrap items-center gap-2">
    <span class:list={['badge', statusBadgeClass]} data-i18n={statusI18nKey}>{status}</span>
    <span class="p-tiny ml-auto text-[var(--text-secondary)]">{dateLabel}</span>
  </div>

  <a href={href} class="no-underline">
    <h4 class="text-xl font-semibold text-[var(--text-primary)] hover:text-primary">{title}</h4>
  </a>
  <p class="p-small text-[var(--text-secondary)]">{authors.join(', ')}</p>
  <p class="p-small italic text-[var(--text-secondary)]">{venue}</p>

  {
    keywords.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {keywords.slice(0, 4).map((k) => (
          <span class="badge">{k}</span>
        ))}
      </div>
    )
  }

  <div class="mt-auto flex items-center justify-between gap-2 pt-1">
    <a href={href} class="link inline-flex min-h-[44px] items-center text-sm" data-i18n="publications.details">
      Details
    </a>
    {
      externalLink && (
        <a
          href={externalLink.url}
          target="_blank"
          rel="noopener noreferrer"
          class="link inline-flex min-h-[44px] items-center gap-1 text-sm"
        >
          {externalLink.label}
          <span aria-hidden="true">&rarr;</span>
        </a>
      )
    }
  </div>
</div>
