---
import BaseLayout from '../../components/Layout/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('news', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug } }));
}

const { slug } = Astro.params;
const entries = await getCollection('news', ({ data }) => !data.draft);
const entry = entries.find((e) => e.data.slug === slug);

if (!entry) {
  Astro.response.status = 404;
}

const Content = entry ? (await render(entry)).Content : null;
const item = entry?.data;

const formattedDate = item?.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={item?.title ?? 'News item not found'} description={item?.title ?? 'This news item could not be found.'} type="article">
  {
    item ? (
      <article class="px-4 py-2xl md:px-6 lg:px-12">
        <div class="mx-auto flex max-w-3xl flex-col gap-6">
          <a href="/news" class="link inline-flex min-h-[44px] w-fit items-center text-sm">&larr; Back to News</a>

          <div class="flex flex-wrap items-center gap-2">
            <span class="badge">{item.category}</span>
            <span class="p-tiny text-[var(--text-secondary)]">{formattedDate}</span>
          </div>

          <h1>{item.title}</h1>

          <div class="prose-content flex flex-col gap-4">
            {Content && <Content />}
          </div>
        </div>
      </article>
    ) : (
      <div class="flex min-h-[50vh] flex-col items-center justify-center gap-4 px-4 text-center">
        <h1>News item not found</h1>
        <a href="/news" class="btn-primary">Back to News</a>
      </div>
    )
  }
</BaseLayout>
