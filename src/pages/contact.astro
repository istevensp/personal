---
import BaseLayout from '../components/Layout/BaseLayout.astro';
import { getEntry } from 'astro:content';

export const prerender = true;

const personalEntry = await getEntry('personal', 'data');
const personal = personalEntry.data;
const initials = `${personal.firstName[0]}${personal.lastName[0]}`.toUpperCase();
---

<BaseLayout title="Contact Me" description="Get in touch via email or LinkedIn, and download the CV.">
  <section class="animate-fade-in bg-gradient-to-br from-primary/10 via-transparent to-secondary/10 px-4 py-3xl md:px-6 lg:px-12">
    <div class="mx-auto grid max-w-container grid-cols-1 items-center gap-8 md:grid-cols-[1fr_auto]">
      <div class="flex flex-col items-start gap-4">
        <h1 class="flex items-center gap-3">
          Contact Me
          <span class="inline-block origin-[70%_70%] animate-wave text-4xl" aria-hidden="true">👋</span>
        </h1>
        <p class="max-w-xl text-[var(--text-secondary)]">
          Feel free to reach out through email or LinkedIn.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={`mailto:${personal.email.institutional}`}
            class="btn-primary hover:-translate-y-0.5"
            data-i18n="common.email"
          >
            Email
          </a>
          <a
            href={personal.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary hover:-translate-y-0.5"
            data-i18n="common.linkedin"
          >
            LinkedIn
          </a>
        </div>
      </div>

      <div class="relative mx-auto h-40 w-40 shrink-0 animate-float overflow-hidden rounded-2xl border border-[var(--border)] bg-gradient-to-br from-primary to-secondary shadow-lg md:mx-0">
        <span class="absolute inset-0 flex items-center justify-center text-4xl font-semibold text-white">
          {initials}
        </span>
        <img
          src="/images/profile.jpg"
          alt={personal.fullName}
          class="absolute inset-0 h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </section>

  <section id="cv" class="px-4 py-3xl md:px-6 lg:px-12">
    <div class="mx-auto flex max-w-container flex-col items-start gap-4">
      <h2>CV &amp; Resume</h2>
      <p class="max-w-xl text-[var(--text-secondary)]">
        Download the most recent industry and academic CVs as PDF.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="https://github.com/istevensp/personal/raw/main/docs/cv-industry.pdf"
          class="btn-primary hover:-translate-y-0.5"
          data-i18n="common.downloadIndustryCv"
        >
          Download Industry CV
        </a>
        <a
          href="https://github.com/istevensp/personal/raw/main/docs/cv-academic.pdf"
          class="btn-secondary hover:-translate-y-0.5"
          data-i18n="common.downloadAcademicCv"
        >
          Download Academic CV
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
