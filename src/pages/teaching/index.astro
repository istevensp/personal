---
import BaseLayout from '../../components/Layout/BaseLayout.astro';
import CourseCard from '../../components/Cards/CourseCard.astro';
import TimelineToggle from '../../components/Publications/PublicationsTimelineToggle.astro';
import { getEntry, getCollection } from 'astro:content';

export const prerender = true;

const coursesEntry = await getEntry('courses', 'data');
const evaluacionesEntry = await getEntry('evaluaciones', 'data');
const syllabusEntries = await getCollection('teachingSyllabus');

const courses = coursesEntry.data.courses;
const evaluations = evaluacionesEntry.data.evaluations;

// Course codes with at least one syllabus file — used to show a "View
// course details" link on the matching card(s). Drop new files into
// src/content/teaching/syllabus/ and they show up here automatically.
const codesWithSyllabus = new Set(syllabusEntries.map((s) => s.data.course.code));
function syllabusHrefFor(code: string): string | undefined {
  return codesWithSyllabus.has(code) ? `/teaching/${code.toLowerCase()}` : undefined;
}

// The SAAC export's `courseName` is ALL CAPS; the confirmed name mappings
// below are written in normal case. Compare/lookup using a normalized
// (upper-cased, trimmed) key on both sides so they actually match.
function normalizeCourseName(value: string): string {
  return value.trim().toUpperCase();
}

// Official English translations for historical SAAC course names, confirmed
// by the site owner — used everywhere a historical course name is displayed,
// instead of the raw Spanish SAAC name.
const COURSE_NAME_TRANSLATIONS: Record<string, string> = {
  'Calidad de Servicio y Redes Multimedia': 'Quality of Service and Multimedia Networks',
  'Estructuras de Datos': 'Data Structures',
  'Fundamentos de Programación': 'Programming Fundamentals',
  Internetworking: 'Internetworking',
  'Programación de Sistemas Telemáticos': 'Telematics Systems Programming',
  'Redes Inalámbricas y de Sensores': 'Wireless and Sensor Networks',
  'Redes de Datos': 'Data Networks',
  'Sistemas Distribuidos y Computación en la Nube': 'Distributed Systems and Cloud Computing',
  'Telemetría y Sistemas Ciberfísicos': 'Telemetry and Cyber-Physical Systems',
};
const normalizedTranslations = new Map(
  Object.entries(COURSE_NAME_TRANSLATIONS).map(([es, en]) => [normalizeCourseName(es), en])
);

// Some historical SAAC course names are the same course as one of the
// current entries in `courses.yaml`, just recorded under its official
// Spanish name — confirmed by the site owner via `historicalNames` on the
// matching course (e.g. "Estructuras de Datos" = "Data Structures").
const historicalNameToCourse = new Map<string, (typeof courses)[number]>();
for (const course of courses) {
  for (const historicalName of course.historicalNames) {
    historicalNameToCourse.set(normalizeCourseName(historicalName), course);
  }
}

// A current course's own `code` field is often still `[PROPORCIONAR]`, but
// if it's confirmed the same course as a historical one (via
// `historicalNames`), it has a real SAAC course code too — resolve it so
// the "View course details" link works from the Current Courses card as
// well, not just the historical one.
const courseIdToRealCode = new Map<string, string>();
for (const evaluation of evaluations) {
  const matched = historicalNameToCourse.get(normalizeCourseName(evaluation.courseName));
  if (matched) courseIdToRealCode.set(matched.courseId, evaluation.courseCode);
}

function realCodeForCourse(course: (typeof courses)[number]): string | undefined {
  return course.code && course.code !== '[PROPORCIONAR]' ? course.code : courseIdToRealCode.get(course.courseId);
}

function syllabusHrefForCourse(course: (typeof courses)[number]): string | undefined {
  const code = realCodeForCourse(course);
  return code ? syllabusHrefFor(code) : undefined;
}

// Historical semesters for a current course, so its Current Courses card
// shows the full "years taught" range (e.g. 2024–2026), not just the 2026
// semester(s) in `courses.yaml` — matching what its merged Historical
// Teaching Record card already shows. `historicalByCode` is populated
// further down the file, but since this function isn't called until the
// Current Courses grid renders (after that point), it's already filled in.
function historicalSemestersForCourse(course: (typeof courses)[number]) {
  const code = realCodeForCourse(course);
  const group = code ? historicalByCode.get(code) : undefined;
  if (!group) return [];
  return group.records.map((r) => ({
    semester: `${r.year}-${r.academicPeriod}`,
    parallel: r.parallel,
    evaluationUrl: r.evaluationUrl,
    status: 'completed' as const,
  }));
}

function displayCourseName(rawName: string): string {
  const normalized = normalizeCourseName(rawName);
  const matchedCourse = historicalNameToCourse.get(normalized);
  return matchedCourse ? matchedCourse.name : (normalizedTranslations.get(normalized) ?? rawName);
}

function anchorForCourseName(rawName: string, courseCode: string): string {
  const matchedCourse = historicalNameToCourse.get(normalizeCourseName(rawName));
  return matchedCourse ? `course-${matchedCourse.courseId}` : `course-${courseCode}`;
}

// English display name -> official Spanish name, for the EN/ES toggle.
// Confirmed by the site owner one by one — not always a literal reverse of
// COURSE_NAME_TRANSLATIONS above, since a course's SAAC record can be in
// English already (e.g. "Internetworking") while its real Spanish course
// name is something else entirely ("Conmutación y Enrutamiento"). Courses
// with no confirmed Spanish name show the same text in both languages
// rather than a guessed translation.
const SPANISH_NAMES: Record<string, string> = {
  'Quality of Service and Multimedia Networks': 'Calidad de Servicio y Redes Multimedia',
  'Data Structures': 'Estructuras de Datos',
  'Programming Fundamentals': 'Fundamentos de Programación',
  Internetworking: 'Conmutación y Enrutamiento',
  'Telematics Systems Programming': 'Programación de Sistemas Telemáticos',
  'Wireless and Sensor Networks': 'Redes Inalámbricas y de Sensores',
  'Data Networks': 'Redes de Datos',
  'Distributed Systems and Cloud Computing': 'Sistemas Distribuidos y Computación en la Nube',
  'Telemetry and Cyber-Physical Systems': 'Telemetría y Sistemas Ciberfísicos',
  'Algorithm Analysis': 'Análisis de Algoritmos',
};
const courseNameToSpanish = new Map(Object.entries(SPANISH_NAMES));

// Historical record grouped straight from the SAAC evaluation export.
// Kept separate from the curated `courses` list above rather than merged by
// guessing a courseId/code match — several course names don't correspond
// 1:1 (e.g. "Algorithm Analysis" has no matching SAAC course code in the export).
// `displayName` uses the English translation (or the matching current
// course's name, when the same course is also taught today).
const historicalByCode = new Map<string, { courseName: string; displayName: string; courseCode: string; records: typeof evaluations }>();
for (const evaluation of evaluations) {
  const key = evaluation.courseCode;
  if (!historicalByCode.has(key)) {
    historicalByCode.set(key, {
      courseName: evaluation.courseName,
      displayName: displayCourseName(evaluation.courseName),
      courseCode: evaluation.courseCode,
      records: [],
    });
  }
  historicalByCode.get(key)!.records.push(evaluation);
}

const areaLabels: Record<string, string> = {
  CCPG: 'Computer Science',
  TLMG: 'Telematics & Networks',
};
const areaLabelsEs: Record<string, string> = {
  'Computer Science': 'Ciencias de la Computación',
  'Telematics & Networks': 'Telemática y Redes',
};

function areaFor(code: string) {
  const prefix = code.match(/^[A-Z]+/)?.[0] ?? '';
  return areaLabels[prefix] ?? 'Other';
}

const historicalCourses = Array.from(historicalByCode.values())
  .map((group) => {
    const records = group.records.sort((a, b) => b.year - a.year || b.term - a.term);

    // If this historical course is confirmed the same as a current one (via
    // `historicalNames`), it's genuinely the same course — the "N parallels
    // across M semesters" description, the "years" badge, and the
    // evaluations accordion should all count the semester(s) it's being
    // taught *right now* too, not just the ones with a completed SAAC
    // evaluation on file. Otherwise the totals shown would undercount a
    // course that's still being actively taught.
    const matchedCourse = historicalNameToCourse.get(normalizeCourseName(group.courseName));
    const currentSemesters = matchedCourse ? matchedCourse.semesters.filter((s) => s.status !== 'upcoming') : [];
    const currentYears = currentSemesters.map((s) => parseInt(s.semester.split('-')[0], 10));

    const totalParallelCount = records.length + currentSemesters.length;
    const distinctSemesters = new Set([
      ...records.map((r) => `${r.year}-${r.academicPeriod}`),
      ...currentSemesters.map((s) => s.semester),
    ]).size;
    const years = Array.from(new Set([...records.map((r) => r.year), ...currentYears])).sort((a, b) => b - a);

    return { ...group, area: areaFor(group.courseCode), records, totalParallelCount, distinctSemesters, years, currentSemesters };
  })
  .sort((a, b) => b.years[0] - a.years[0]);

const areas = ['All', ...Array.from(new Set(historicalCourses.map((g) => g.area))).sort()];
const years = ['All', ...Array.from(new Set(historicalCourses.flatMap((g) => g.years))).sort((a, b) => b - a)];

// Teaching timeline: one column per semester, combining the historical SAAC
// export with the curated `courses` list (current 2026 semesters only —
// upcoming/not-yet-started semesters are excluded so the timeline stops at
// "today", not at whatever is planned). Historical courses that are also
// taught today are merged into a single entry (same display name, color,
// and card anchor) via `displayCourseName`/`anchorForCourseName` above.
function termFromPeriod(period: string): number {
  return Number(period.match(/^(\d+)S$/)?.[1] ?? 0);
}

// `courses` here is a Map of display name -> number of parallels taught
// *that semester* (a course can have several parallels in the same
// semester, e.g. 4 sections of "Data Networks" in one term — each is a
// separate SAAC evaluation record / `courses.yaml` semester entry).
const semesterMap = new Map<string, { label: string; year: number; term: number; courses: Map<string, number> }>();
// Anchor id of the card each course name should scroll to when clicked.
const courseAnchorMap = new Map<string, string>();

for (const evaluation of evaluations) {
  const key = `${evaluation.year}-${evaluation.academicPeriod}`;
  if (!semesterMap.has(key)) {
    semesterMap.set(key, { label: key, year: evaluation.year, term: termFromPeriod(evaluation.academicPeriod), courses: new Map() });
  }
  const entry = semesterMap.get(key)!;

  const name = displayCourseName(evaluation.courseName);
  const anchor = anchorForCourseName(evaluation.courseName, evaluation.courseCode);

  entry.courses.set(name, (entry.courses.get(name) ?? 0) + 1);
  courseAnchorMap.set(name, anchor);
}

for (const course of courses) {
  for (const sem of course.semesters) {
    if (sem.status === 'upcoming') continue; // not yet underway — keep the timeline at "today"
    const [yearStr, period] = sem.semester.split('-');
    const key = sem.semester;
    if (!semesterMap.has(key)) {
      semesterMap.set(key, { label: key, year: Number(yearStr), term: termFromPeriod(period), courses: new Map() });
    }
    const entry = semesterMap.get(key)!;
    entry.courses.set(course.name, (entry.courses.get(course.name) ?? 0) + 1);
    courseAnchorMap.set(course.name, `course-${course.courseId}`);
  }
}

// Newest first.
const teachingTimeline = Array.from(semesterMap.values())
  .filter((s) => s.courses.size > 0)
  .sort((a, b) => b.year - a.year || b.term - a.term);

const timelineYears = teachingTimeline.map((s) => s.year);
const timelineFirstYear = timelineYears.length > 0 ? Math.min(...timelineYears) : null;

// Total individual parallels/sections taught (each SAAC evaluation record is
// one parallel; each non-upcoming `courses.yaml` semester entry is one too).
const totalParallels =
  evaluations.length + courses.flatMap((c) => c.semesters).filter((s) => s.status !== 'upcoming').length;

// One consistent color per distinct course, assigned alphabetically so it
// doesn't reshuffle every time a new semester is added.
const COURSE_COLORS = [
  'bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300',
  'bg-orange-100 text-orange-800 dark:bg-orange-900/40 dark:text-orange-300',
  'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
  'bg-lime-100 text-lime-800 dark:bg-lime-900/40 dark:text-lime-300',
  'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
  'bg-teal-100 text-teal-800 dark:bg-teal-900/40 dark:text-teal-300',
  'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/40 dark:text-cyan-300',
  'bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-300',
  'bg-violet-100 text-violet-800 dark:bg-violet-900/40 dark:text-violet-300',
  'bg-fuchsia-100 text-fuchsia-800 dark:bg-fuchsia-900/40 dark:text-fuchsia-300',
  'bg-pink-100 text-pink-800 dark:bg-pink-900/40 dark:text-pink-300',
  'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-300',
];
const COURSE_DOT_COLORS = [
  'bg-rose-400',
  'bg-orange-400',
  'bg-amber-400',
  'bg-lime-400',
  'bg-emerald-400',
  'bg-teal-400',
  'bg-cyan-400',
  'bg-sky-400',
  'bg-violet-400',
  'bg-fuchsia-400',
  'bg-pink-400',
  'bg-indigo-400',
];

// Total parallels per course across all semesters — this is what the legend
// badges show, and they must sum to `totalParallels` above.
const courseParallelTotals = new Map<string, number>();
for (const s of teachingTimeline) {
  for (const [name, count] of s.courses) {
    courseParallelTotals.set(name, (courseParallelTotals.get(name) ?? 0) + count);
  }
}

const distinctCourseNames = Array.from(courseParallelTotals.keys()).sort();
const courseColorMap = new Map(distinctCourseNames.map((name, i) => [name, COURSE_COLORS[i % COURSE_COLORS.length]]));
const courseDotColorMap = new Map(distinctCourseNames.map((name, i) => [name, COURSE_DOT_COLORS[i % COURSE_DOT_COLORS.length]]));
const distinctCourseCount = distinctCourseNames.length;

const timelineSummaryEn = `${distinctCourseCount} distinct course${distinctCourseCount === 1 ? '' : 's'} taught over ${teachingTimeline.length} semester${teachingTimeline.length === 1 ? '' : 's'} (${totalParallels} parallel${totalParallels === 1 ? '' : 's'} total)${timelineFirstYear ? ` since ${timelineFirstYear}` : ''}.`;
const timelineSummaryEs = `${distinctCourseCount} materia${distinctCourseCount === 1 ? '' : 's'} distinta${distinctCourseCount === 1 ? '' : 's'} dictada${distinctCourseCount === 1 ? '' : 's'} en ${teachingTimeline.length} semestre${teachingTimeline.length === 1 ? '' : 's'} (${totalParallels} paralelo${totalParallels === 1 ? '' : 's'} en total)${timelineFirstYear ? ` desde ${timelineFirstYear}` : ''}.`;

const historicalSummaryEn = `A quick look back at every course I've taught since 2021 — ${historicalCourses.length} courses, based on ${evaluations.length} official SAAC evaluations, newest first.`;
const historicalSummaryEs = `Un vistazo a todas las materias que he dictado desde 2021 — ${historicalCourses.length} cursos, según ${evaluations.length} evaluaciones oficiales del SAAC, empezando por las más recientes.`;
---

<BaseLayout title="Teaching" description="Courses taught and historical student evaluation records at ESPOL.">
  <section class="px-4 py-2xl md:px-6 lg:px-12">
    <div class="mx-auto flex max-w-container flex-col gap-3xl">
      <div class="flex flex-col gap-4">
        <h1 data-i18n="nav.teaching">Teaching</h1>
        <p class="max-w-2xl text-[var(--text-secondary)]">
          <span data-i18n="teaching.introPrefix">Current and historical courses taught at</span>{' '}
          <a href="https://www.espol.edu.ec/en" target="_blank" rel="noopener noreferrer" class="link">ESPOL</a><span data-i18n="teaching.introSuffix">, with links to official SAAC student evaluation reports.</span>
        </p>
      </div>

      {
        teachingTimeline.length > 0 && (
          <div class="flex flex-col gap-4 rounded-lg border border-primary/20 bg-primary/5 p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="flex items-center gap-2 p-body font-medium text-[var(--text-primary)]">
                <span class="animate-bounce text-xl" aria-hidden="true">🎓</span>
                <span data-lang-en={timelineSummaryEn} data-lang-es={timelineSummaryEs}>{timelineSummaryEn}</span>
              </p>
              <TimelineToggle targetId="teaching-timeline-row" defaultExpanded={false} />
            </div>

            <div id="teaching-timeline-row" class:list={['flex flex-col gap-5', 'hidden']}>
              <div class="grid grid-cols-1 gap-x-4 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
                {distinctCourseNames.map((name) => (
                  <a
                    href={`#${courseAnchorMap.get(name)}`}
                    class="flex min-h-[36px] items-center gap-2 rounded-md px-2 text-sm text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-secondary)] hover:text-primary"
                  >
                    <span class:list={['h-2.5 w-2.5 shrink-0 rounded-full', courseDotColorMap.get(name)]} />
                    <span class="truncate" data-lang-en={courseNameToSpanish.has(name) ? name : undefined} data-lang-es={courseNameToSpanish.get(name)}>{name}</span>
                    <span class="ml-auto shrink-0 text-xs">&times;{courseParallelTotals.get(name)}</span>
                  </a>
                ))}
              </div>

              <div class="flex flex-col gap-5 border-l-2 border-[var(--border)] pl-5">
                {teachingTimeline.map((s) => (
                  <div class="relative">
                    <span class="absolute -left-[1.6rem] top-1 h-3 w-3 rounded-full bg-primary" />
                    <p class="p-small font-semibold text-[var(--text-primary)]">{s.label}</p>
                    <div class="mt-1.5 flex flex-wrap gap-1.5">
                      {Array.from(s.courses.entries()).map(([c, count]) => (
                        <a
                          href={`#${courseAnchorMap.get(c)}`}
                          class:list={['inline-flex min-h-[44px] items-center rounded-md px-3 py-2 text-xs font-medium leading-snug transition-opacity hover:opacity-75', courseColorMap.get(c)]}
                        >
                          <span data-lang-en={courseNameToSpanish.has(c) ? c : undefined} data-lang-es={courseNameToSpanish.get(c)}>{c}</span>
                          {count > 1 && ` ×${count}`}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )
      }

      <div class="flex flex-col gap-6">
        <h2 data-i18n="teaching.currentCourses">Current Courses</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {courses.map((course) => (
            <CourseCard
              id={`course-${course.courseId}`}
              name={course.name}
              nameEs={courseNameToSpanish.get(course.name)}
              code={realCodeForCourse(course) ?? course.code}
              level={course.level}
              description={course.description}
              topics={course.topics}
              repositoryUrl={course.repositoryUrl}
              materialsLink={course.materialsLink}
              semesters={[...historicalSemestersForCourse(course), ...course.semesters]}
              syllabusHref={syllabusHrefForCourse(course)}
            />
          ))}
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <h2 data-i18n="teaching.historicalRecord">Historical Teaching Record</h2>
        <p
          class="p-small max-w-2xl text-[var(--text-secondary)]"
          data-lang-en={historicalSummaryEn}
          data-lang-es={historicalSummaryEs}
        >
          {historicalSummaryEn}
        </p>

        <div class="flex flex-col gap-3">
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter historical courses by area" id="area-filters">
            {areas.map((area, i) => (
              <button
                type="button"
                data-area-filter={area}
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-i18n={area === 'All' ? 'common.all' : undefined}
                data-lang-en={area === 'All' ? undefined : area}
                data-lang-es={area === 'All' ? undefined : (areaLabelsEs[area] ?? area)}
                class:list={[
                  'min-h-[44px] rounded-full px-4 py-2 text-sm font-medium transition duration-fast',
                  i === 0
                    ? 'bg-primary text-white'
                    : 'border border-[var(--border)] text-[var(--text-secondary)] hover:bg-gray-100 dark:hover:bg-gray-800',
                ]}
              >
                {area}
              </button>
            ))}
          </div>

          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter historical courses by year" id="year-filters">
            {years.map((year, i) => (
              <button
                type="button"
                data-year-filter={year}
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-i18n={year === 'All' ? 'common.all' : undefined}
                class:list={[
                  'min-h-[44px] rounded-full px-4 py-2 text-sm font-medium transition duration-fast',
                  i === 0
                    ? 'bg-secondary text-white'
                    : 'border border-[var(--border)] text-[var(--text-secondary)] hover:bg-gray-100 dark:hover:bg-gray-800',
                ]}
              >
                {year}
              </button>
            ))}
          </div>
        </div>

        <div id="historical-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {historicalCourses.map((group) => (
            <div data-area={group.area} data-years={group.years.join(' ')}>
              <CourseCard
                id={`course-${group.courseCode}`}
                name={group.displayName}
                nameEs={courseNameToSpanish.get(group.displayName)}
                code={group.courseCode}
                level=""
                description={`${group.totalParallelCount} parallel${group.totalParallelCount === 1 ? '' : 's'} taught across ${group.distinctSemesters} semester${group.distinctSemesters === 1 ? '' : 's'}.`}
                descriptionEs={`${group.totalParallelCount} paralelo${group.totalParallelCount === 1 ? '' : 's'} dictado${group.totalParallelCount === 1 ? '' : 's'} en ${group.distinctSemesters} semestre${group.distinctSemesters === 1 ? '' : 's'}.`}
                topics={[]}
                repositoryUrl=""
                semesters={[
                  ...group.records.map((r) => ({
                    semester: `${r.year}-${r.academicPeriod}`,
                    parallel: r.parallel,
                    evaluationUrl: r.evaluationUrl,
                  })),
                  ...group.currentSemesters,
                ]}
                syllabusHref={syllabusHrefFor(group.courseCode)}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    const areaFilterGroup = document.getElementById('area-filters');
    const yearFilterGroup = document.getElementById('year-filters');
    const grid = document.getElementById('historical-grid');

    let currentArea = 'All';
    let currentYear = 'All';

    function applyFilters() {
      grid?.querySelectorAll<HTMLElement>('[data-area]').forEach((card) => {
        const areaMatch = currentArea === 'All' || card.dataset.area === currentArea;
        const yearMatch = currentYear === 'All' || (card.dataset.years?.split(' ') ?? []).includes(currentYear);
        card.classList.toggle('hidden', !(areaMatch && yearMatch));
      });
    }

    function wireFilterGroup(
      group: HTMLElement | null,
      attr: string,
      activeClass: string,
      onSelect: (value: string) => void
    ) {
      group?.addEventListener('click', (e) => {
        const button = (e.target as HTMLElement).closest<HTMLButtonElement>(`[data-${attr}]`);
        if (!button) return;

        group.querySelectorAll<HTMLButtonElement>(`[data-${attr}]`).forEach((b) => {
          b.setAttribute('aria-pressed', 'false');
          b.className = 'min-h-[44px] rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-gray-100 dark:hover:bg-gray-800';
        });
        button.setAttribute('aria-pressed', 'true');
        button.className = `min-h-[44px] rounded-full ${activeClass} px-4 py-2 text-sm font-medium text-white`;

        onSelect(button.dataset[attr === 'area-filter' ? 'areaFilter' : 'yearFilter'] ?? 'All');
        applyFilters();
      });
    }

    wireFilterGroup(areaFilterGroup, 'area-filter', 'bg-primary', (value) => (currentArea = value));
    wireFilterGroup(yearFilterGroup, 'year-filter', 'bg-secondary', (value) => (currentYear = value));
  </script>
</BaseLayout>
