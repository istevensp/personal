---
import BaseLayout from '../components/Layout/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="flex min-h-[60vh] flex-col items-center justify-center gap-4 px-4 text-center">
    <h1 class="text-6xl">404</h1>
    <p class="text-lg text-[var(--text-secondary)]">This page doesn't exist.</p>
    <a href="/" class="btn-primary">Back to Home</a>
  </section>
</BaseLayout>
