---
import BaseLayout from '../components/Layout/BaseLayout.astro';
import HeroSection from '../components/Home/HeroSection.astro';
import PublicationsTimeline from '../components/Home/PublicationsTimeline.astro';
import FeaturedProjects from '../components/Home/FeaturedProjects.astro';
import RecentNews from '../components/Home/RecentNews.astro';
import { getEntry } from 'astro:content';

export const prerender = true;

const personalEntry = await getEntry('personal', 'data');
const personal = personalEntry.data;
const shortName = `${personal.firstName} ${personal.lastName.split(' ')[0]}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: personal.fullName,
  url: personal.website,
  email: personal.email.institutional,
  affiliation: { '@type': 'Organization', name: 'ESPOL' },
};
---

<BaseLayout title={shortName} description={personal.summary} jsonLd={jsonLd}>
  <HeroSection />
  <PublicationsTimeline />
  <FeaturedProjects />
  <RecentNews />
</BaseLayout>
