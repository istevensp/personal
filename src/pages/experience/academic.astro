---
import BaseLayout from '../../components/Layout/BaseLayout.astro';
import ExperienceCard from '../../components/Cards/ExperienceCard.astro';
import { getEntry } from 'astro:content';

export const prerender = true;

const academicEntry = await getEntry('academicExperience', 'data');

const academic = [...academicEntry.data.academicExperience].sort((a, b) => b.startDate.localeCompare(a.startDate));
---

<BaseLayout title="Academic Experience" description="Academic experience record.">
  <section class="px-4 py-2xl md:px-6 lg:px-12">
    <div class="mx-auto flex max-w-container flex-col gap-3xl">
      <div class="flex flex-col gap-4">
        <a href="/experience" class="link inline-flex min-h-[44px] w-fit items-center text-sm">&larr; Back to Experience</a>
        <h1>Academic Experience</h1>
      </div>

      <div class="flex flex-col gap-4">
        {academic.map((exp) => (
          <ExperienceCard
            title={exp.title}
            organization={exp.institution}
            location={exp.location}
            startDate={exp.startDate}
            endDate={exp.endDate}
            current={exp.current}
            description={exp.description}
            highlights={exp.highlights}
            highlightsEs={exp.highlightsEs}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
