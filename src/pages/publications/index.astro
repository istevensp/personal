---
import BaseLayout from '../../components/Layout/BaseLayout.astro';
import PublicationCard from '../../components/Cards/PublicationCard.astro';
import PublicationsTimelineRow from '../../components/Publications/PublicationsTimelineRow.astro';
import PublicationsTimelineToggle from '../../components/Publications/PublicationsTimelineToggle.astro';
import { getEntry } from 'astro:content';
import { formatMonthYear, primaryExternalLink } from '../../lib/publications';

export const prerender = true;

const publishedEntry = await getEntry('publicationsPublished', 'data');
const acceptedEntry = await getEntry('publicationsAccepted', 'data');
const underReviewEntry = await getEntry('publicationsUnderReview', 'data');

const published = publishedEntry.data.published
  .map((p) => ({
    href: `/publications/${p.id}`,
    title: p.title,
    authors: p.authors,
    venue: p.conference,
    dateLabel: formatMonthYear(p.year, p.month),
    sortKey: p.year * 100 + p.month,
    status: p.status,
    keywords: p.keywords,
    externalLink: primaryExternalLink(p.doi, p.links),
  }))
  .sort((a, b) => b.sortKey - a.sortKey);

const accepted = acceptedEntry.data.accepted
  .map((p) => ({
    href: `/publications/${p.id}`,
    title: p.title,
    authors: p.authors,
    venue: p.conference,
    dateLabel: formatMonthYear(p.year, p.month),
    sortKey: p.year * 100 + (p.month ?? 0),
    status: p.status,
    keywords: p.keywords,
    externalLink: primaryExternalLink(p.doi, p.links),
  }))
  .sort((a, b) => b.sortKey - a.sortKey);

const underReview = underReviewEntry.data.underReview
  .map((p) => ({
    href: `/publications/${p.id}`,
    title: p.title,
    authors: p.authors,
    venue: p.journal,
    dateLabel: formatMonthYear(p.year),
    sortKey: p.year * 100,
    status: p.status,
    keywords: p.keywords,
    externalLink: primaryExternalLink(null, p.links),
  }))
  .sort((a, b) => b.sortKey - a.sortKey);

// Default (unfiltered) order: Published first (chronological), then Accepted,
// then Under Review — grouped, not interleaved by date.
const groups = [
  { status: 'Published', items: published },
  { status: 'Accepted', items: accepted },
  { status: 'Under Review', items: underReview },
].filter((g) => g.items.length > 0);

const timelineAll = [...published, ...accepted, ...underReview].sort((a, b) => b.sortKey - a.sortKey);
---

<BaseLayout title="Publications" description="Published, accepted, and under-review research publications.">
  <section class="px-4 py-2xl md:px-6 lg:px-12">
    <div class="mx-auto flex max-w-container flex-col gap-6">
      <h1 data-i18n="nav.publications">Publications</h1>

      {
        timelineAll.length > 0 && (
          <div class="flex flex-col gap-3 rounded-lg border border-primary/20 bg-primary/5 p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="flex items-center gap-2 p-body font-medium text-[var(--text-primary)]">
                <span class="animate-bounce text-xl" aria-hidden="true">📊</span>
                <span data-i18n="common.timelinePrompt">Prefer a quick timeline view?</span>
              </p>
              <PublicationsTimelineToggle defaultExpanded={false} />
            </div>
            <PublicationsTimelineRow timeline={timelineAll} hidden={true} />
          </div>
        )
      }

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter publications by status" id="pub-filters">
        <button type="button" data-status-filter="All" aria-pressed="true" data-i18n="common.all" class="min-h-[44px] rounded-full bg-primary px-4 py-2 text-sm font-medium text-white">All</button>
        <button type="button" data-status-filter="Published" aria-pressed="false" data-i18n="publications.published" class="min-h-[44px] rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-gray-100 dark:hover:bg-gray-800">Published</button>
        <button type="button" data-status-filter="Accepted" aria-pressed="false" data-i18n="publications.accepted" class="min-h-[44px] rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-gray-100 dark:hover:bg-gray-800">Accepted</button>
        <button type="button" data-status-filter="Under Review" aria-pressed="false" data-i18n="publications.underReview" class="min-h-[44px] rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-gray-100 dark:hover:bg-gray-800">Under Review</button>
      </div>

      <div id="pub-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          groups.map((group, i) => (
            <>
              {i > 0 && (
                <div
                  data-divider
                  class="col-span-full my-2 border-t border-[var(--border)]"
                />
              )}
              {group.items.map((p) => (
                <div data-status={p.status}>
                  <PublicationCard {...p} />
                </div>
              ))}
            </>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const filterGroup = document.getElementById('pub-filters');
    const grid = document.getElementById('pub-grid');

    filterGroup?.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-status-filter]');
      if (!button) return;

      filterGroup.querySelectorAll('[data-status-filter]').forEach((b) => {
        b.setAttribute('aria-pressed', 'false');
        b.className = 'min-h-[44px] rounded-full border border-[var(--border)] px-4 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-gray-100 dark:hover:bg-gray-800';
      });
      button.setAttribute('aria-pressed', 'true');
      button.className = 'min-h-[44px] rounded-full bg-primary px-4 py-2 text-sm font-medium text-white';

      const status = button.dataset.statusFilter;
      grid?.querySelectorAll<HTMLElement>('[data-status]').forEach((card) => {
        card.classList.toggle('hidden', status !== 'All' && card.dataset.status !== status);
      });
      grid?.querySelectorAll<HTMLElement>('[data-divider]').forEach((divider) => {
        divider.classList.toggle('hidden', status !== 'All');
      });
    });
  </script>
</BaseLayout>
